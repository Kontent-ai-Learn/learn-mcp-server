# Port for running the MCP server locally (optional)
Port=3002
# Path to folder where data-related files are stored (e.g. database)
DataPath=data
# transformers.js model cache dir (optional; default .cache/transformers)
CacheDir=.cache
# Base URL of the Learn host used to fetch indexable content. When unset, fetching fails.
LearnHost=http://localhost:3000
# Optional path override for the search-records endpoint
SearchRecordsUrl=learn/api/ai/getSearchRecords
# Optional path override for the API-reference-endpoints endpoint
ApiReferenceEndpointsUrl=learn/api/ai/getApiReferenceEndpoints
# Optional path override for the API-reference-objects endpoint
ApiReferenceObjectsUrl=learn/api/ai/getApiReferenceObjects
