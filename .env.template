# Port for running the MCP server locally (optional)
Port=3002
# Path to folder where data-related files are stored (e.g. database, cached JSON)
DataPath=data
# Base URL of the Learn host used to fetch indexable content. When unset, fetching fails.
LearnHost=http://localhost:3000
# Automatically re-sync the search index from LearnHost once a day (optional, default: true)
AutoSyncEnabled=true
# How often automatic sync runs — a number paired with SyncIntervalUnit (optional, default: 1)
SyncIntervalValue=1
# Unit for SyncIntervalValue: minutes, hours, or days (optional, default: days)
SyncIntervalUnit=days
