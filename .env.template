# Port for running the MCP server locally (optional)
PORT=
# Persistent path to the indexed content DB (optional; default db/learn.db)
DB_PATH=
# transformers.js model cache dir (optional; default .cache/transformers)
CACHE_DIR=
# Base URL of the Learn host used to fetch indexable content. When unset, fetching fails.
LearnHost=http://localhost:3000
# Optional path override for the search-records endpoint (default /learn/api/ai/getSearchRecords)
SearchRecordsUrl=
# Optional path override for the API-reference-records endpoint (default /learn/api/ai/getApiReferenceRecords)
ApiReferenceRecordsUrl=
